# Copiar a backend/.env (ignorado por git) y ajustar.
APP_ENV=dev
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<clave anon/publishable del proyecto>
# Solo para la ingesta de correos (Paso 08). Nunca en la app ni en el repo.
SUPABASE_SERVICE_ROLE_KEY=<clave service_role del proyecto>
# Claves AES-256-GCM de los correos, "versión:base64". Generar una con:
#   python -c "import os,base64; print('1:' + base64.b64encode(os.urandom(32)).decode())"
# Para rotar: añadir "2:<nueva>" separada por coma; las antiguas se quedan para descifrar.
EMAIL_KEYS=<versión:clave en base64>
# Avisos push con FCM (Paso 14, D16). La clave JSON de la cuenta de servicio (rol «Firebase Cloud
# Messaging API Admin») vive FUERA del repo: aquí solo su ruta absoluta. Sin estos dos, no hay avisos.
FCM_CREDENTIALS_FILE=<ruta absoluta a la clave JSON de la cuenta de servicio>
FCM_PROJECT_ID=<id del proyecto de Google Cloud / Firebase>
